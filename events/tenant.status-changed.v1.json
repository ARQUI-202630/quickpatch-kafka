{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tenant.status-changed",
  "description": "El estado de un tenant cambió. Productor: Identity. Consumidor: ServiceRequest (valida disponibilidad según estado del tenant).",
  "type": "object",
  "properties": {
    "tenantId": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["activo", "inactivo", "suspendido"] },
    "changedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["tenantId", "status", "changedAt"],
  "additionalProperties": false
}
